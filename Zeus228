local function PlayersTab()
    local f = Content["Players"]
    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0,8)
    layout.SortOrder = Enum.SortOrder.Name
    layout.Parent = f
    
    local function refresh()
        for _,c in pairs(f:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
        local y = 0
        for _,p in pairs(Players:GetPlayers()) do
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1,-16,0,36)
            btn.Position = UDim2.new(0,8,0,y)
            btn.BackgroundColor3 = Color3.fromRGB(35,35,40)
            round(btn,8)
            btn.Text = p.Name .. (p.Team and " ["..p.Team.Name.."]" or "")
            btn.TextColor3 = Color3.fromRGB(240,240,245)
            btn.TextSize = 14
            btn.Font = Enum.Font.Gotham
            btn.Parent = f
            btn.MouseButton1Click:Connect(function()
                State.target = p
                for _,b in pairs(f:GetChildren()) do if b:IsA("TextButton") then b.BackgroundColor3 = Color3.fromRGB(35,35,40) end end
                btn.BackgroundColor3 = Color3.fromRGB(90,90,110)
            end)
            y = y + 44
        end
        f.CanvasSize = UDim2.new(0,0,0,y)
    end
    refresh()
    Players.PlayerAdded:Connect(refresh)
    Players.PlayerRemoving:Connect(refresh)
    
    local action = Instance.new("Frame")
    action.Size = UDim2.new(1,-16,0,64)
    action.Position = UDim2.new(0,8,1,-72)
    action.BackgroundColor3 = Color3.fromRGB(25,25,28)
    action.BackgroundTransparency = 0.3
    round(action,8)
    action.Parent = f
    
    local function makeBtn(text,color,x,cb)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(0.23,-4,1,-8)
        b.Position = UDim2.new(x,0,0,4)
        b.BackgroundColor3 = color
        round(b,6)
        b.Text = text
        b.TextColor3 = Color3.new(1,1,1)
        b.Font = Enum.Font.GothamBold
        b.TextSize = 12
        b.Parent = action
        b.MouseButton1Click:Connect(cb)
        return b
    end
    makeBtn("KILL",Color3.fromRGB(160,40,40),0.01,function() if State.target then Commands.kill(State.target) end end)
    makeBtn("HEAL",Color3.fromRGB(40,140,40),0.25,function() if State.target then Commands.heal(State.target) end end)
    makeBtn("BRING",Color3.fromRGB(50,90,160),0.49,function() if State.target then Commands.bring(State.target) end end)
    makeBtn("TP TO",Color3.fromRGB(160,120,30),0.73,function() if State.target then Commands.tpTo(State.target) end end)
end

local function TeleportTab()
