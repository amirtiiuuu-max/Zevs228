    list.BackgroundTransparency = 1
    list.ScrollBarThickness = 6
    list.Parent = f
    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0,6)
    layout.Parent = list
    
    local function addTP(name,pos)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1,-16,0,40)
        btn.BackgroundColor3 = Color3.fromRGB(35,35,40)
        round(btn,8)
        btn.Text = name
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 14
        btn.Parent = list
        btn.MouseButton1Click:Connect(function()
            local c = getChar(LP)
            if c and c.PrimaryPart then
                table.insert(State.history, c.PrimaryPart.Position)
                c.PrimaryPart.CFrame = CFrame.new(pos)
            end
        end)
    end
    addTP("Spawn",Vector3.new(0,5,0))
    addTP("Sky (300)",Vector3.new(0,300,0))
    addTP("Void (-500)",Vector3.new(0,-500,0))
    
    local back = Instance.new("TextButton")
    back.Size = UDim2.new(1,-16,0,40)
    back.BackgroundColor3 = Color3.fromRGB(70,50,50)
    round(back,8)
    back.Text = "Back to previous"
    back.Font = Enum.Font.Gotham
    back.TextSize = 14
    back.Parent = list
    back.MouseButton1Click:Connect(function()
        if #State.history > 0 then
            local last = table.remove(State.history)
            local c = getChar(LP)
            if c and c.PrimaryPart then c.PrimaryPart.CFrame = CFrame.new(last) end
        end
    end)
end

local function CombatTab()
    local f = Content["Combat"]
