local function getChar(p) return p.Character and p.Character.Parent and p.Character end
local function getHum(p) local c = getChar(p) return c and c:FindFirstChild("Humanoid") end

local Commands = {}

function Commands.kill(p) local h = getHum(p) if h then h.Health = 0 end end
function Commands.heal(p) local h = getHum(p) if h then h.Health = h.MaxHealth end end
function Commands.bring(p)
    local tc = getChar(p)
    local lc = getChar(LP)
    if tc and lc and lc.PrimaryPart then tc:SetPrimaryPartCFrame(lc.PrimaryPart.CFrame) end
end
function Commands.tpTo(p)
    local tc = getChar(p)
    local lc = getChar(LP)
    if tc and lc and tc.PrimaryPart then lc:SetPrimaryPartCFrame(tc.PrimaryPart.CFrame + Vector3.new(0,2,0)) end
end
function Commands.god(e)
    State.god = e
    local h = getHum(LP)
    if h then
        if e then h.MaxHealth = math.huge; h.Health = math.huge; h.BreakJointsOnDeath = false
        else h.MaxHealth = 100; h.Health = 100; h.BreakJointsOnDeath = true end
    end
end
function Commands.setSpeed(v) State.speed = math.clamp(v,16,350); local h = getHum(LP); if h then h.WalkSpeed = State.speed end end
function Commands.setJump(v) State.jumpPower = math.clamp(v,20,500); local h = getHum(LP); if h then h.JumpPower = State.jumpPower end end
function Commands.infJump(e) State.infJump = e end
function Commands.fly(e)
    State.fly = e
    local c = getChar(LP)
    if not c then return end
    local root = c:FindFirstChild("HumanoidRootPart") or c.PrimaryPart
    if e then
        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(math.huge,math.huge,math.huge)
        bv.Velocity = Vector3.new(0,0,0)
        bv.Parent = root
        c._flyBV = bv
    else if c._flyBV then c._flyBV:Destroy() end end
end
function Commands.noclip(e)
    State.noclip = e
    local c = getChar(LP)
    if c then for _, part in pairs(c:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide = not e end end end
end

LP.CharacterAdded:Connect(function(char)
    wait(0.3)
    if State.noclip then for _, part in pairs(char:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide = false end end end
    if State.fly then
        local root = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
        if root then
            local bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(math.huge,math.huge,math.huge)
            bv.Velocity = Vector3.new(0,0,0)
            bv.Parent = root
            char._flyBV = bv
        end
    end
end)

RS.RenderStepped:Connect(function()
    if State.infJump and UIS:IsKeyDown(Enum.KeyCode.Space) then
        local h = getHum(LP)
        if h and h:GetState() ~= Enum.HumanoidStateType.Jumping then h:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
    if State.fly then
        local c = getChar(LP)
        if c and c._flyBV then
            local cam = workspace.CurrentCamera
            local dir = Vector3.new()
            if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0,1,0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0,1,0) end
            if dir.Magnitude > 0 then dir = dir.Unit * State.flySpeed end
            c._flyBV.Velocity = dir
        end
    end
end)

