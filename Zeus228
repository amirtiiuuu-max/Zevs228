-- Функция для определения редкости предмета по имени/цвету
local function getItemRarity(item)
    local name = string.lower(item.Name)
    local text = ""
    if item:IsA("TextLabel") or item:IsA("TextButton") then
        text = string.lower(item.Text)
    end
    
    if name:find("божествен") or text:find("божествен") or name:find("divine") or item:FindFirstChild("DivineTag") then
        return "divine"
    elseif name:find("мифическ") or text:find("мифическ") or name:find("mythical") or name:find("миф") then
        return "mythical"
    elseif name:find("легендар") or text:find("легендар") or name:find("legendary") then
        return "legendary"
    elseif name:find("эпическ") or text:find("эпическ") or name:find("epic") then
        return "epic"
    elseif name:find("редк") or text:find("редк") or name:find("rare") then
        return "rare"
    else
        return "common"
    end
end

-- Получение цвета для ESP
local function getEspColor(item)
    local rarity = getItemRarity(item)
    return State.settings.rarityColors[rarity] or State.settings.rarityColors.common
end

-- Получение позиции предмета
local function getItemPosition(item)
    if item:IsA("BasePart") then
        return item.Position
    elseif item:IsA("Model") and item.PrimaryPart then
        return item.PrimaryPart.Position
    elseif item:IsA("Tool") and item.Handle then
        return item.Handle.Position
    elseif item.Parent and item.Parent:IsA("BasePart") then
        return item.Parent.Position
    end
    return nil
end

-- Создание ESP для предмета
local function createESP(item)
    if not item or item:FindFirstChild("ZeusESP") then return end
    
    local position = getItemPosition(item)
    if not position then return end
    
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ZeusESP"
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 2, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = State.settings.espDistance
    billboard.Enabled = State.espEnabled
    
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.BackgroundColor3 = getEspColor(item)
    frame.BackgroundTransparency = 0.7
    frame.BorderSizePixel = 0
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = frame
    
    local text = Instance.new("TextLabel")
    text.Size = UDim2.new(1, 0, 1, 0)
    text.BackgroundTransparency = 1
    text.Text = item.Name .. "\n" .. string.upper(getItemRarity(item))
    text.TextColor3 = Color3.new(1,1,1)
    text.TextSize = 12
    text.Font = Enum.Font.GothamBold
    text.TextScaled = true
    text.TextWrapped = true
    text.Parent = frame
    
    frame.Parent = billboard
    
    local attachPoint
    if item:IsA("BasePart") then
        attachPoint = item
    elseif item:IsA("Model") and item.PrimaryPart then
        attachPoint = item.PrimaryPart
    elseif item:IsA("Tool") and item.Handle then
        attachPoint = item.Handle
    else
        local part = item:FindFirstChildWhichIsA("BasePart")
        if part then attachPoint = part end
    end
    
    if attachPoint then
        billboard.Parent = attachPoint
        return billboard
    else
        billboard:Destroy()
        return nil
    end
end

-- Обновление всех ESP
local function refreshESP()
    for _, esp in pairs(workspace:GetDescendants()) do
        if esp.Name == "ZeusESP" then
            esp:Destroy()
        end
    end
    
    -- Поиск предметов для кражи (примерные названия, нужно подстроить под игру)
    local itemsToFind = {"Item", "Loot", "Chest", "Box", "Valuable", "Art", "Painting", "Jewelry", "Gold", "Diamond"}
    
    for _, item in pairs(workspace:GetDescendants()) do
        if item:IsA("BasePart") or item:IsA("Model") or item:IsA("Tool") then
            local nameLower = string.lower(item.Name)
            local shouldESP = false
            
            for _, keyword in pairs(itemsToFind) do
                if nameLower:find(string.lower(keyword)) then
                    shouldESP = true
                    break
                end
            end
            
            if shouldESP and not item:FindFirstChild("Humanoid") then
                createESP(item)
            end
        end
    end
end

-- Телепорт к предмету
local function teleportToItem(item)
    local pos = getItemPosition(item)
    if pos and LP.Character and LP.Character.PrimaryPart then
        LP.Character.PrimaryPart.CFrame = CFrame.new(pos + Vector3.new(0, 2, 0))
    end
end

-- Автоматическая кража (имитация клика/взаимодействия)
local function autoStealLoop()
    while State.autoSteal do
        local closest = nil
        local closestDist = math.huge
        
        for _, esp in pairs(workspace:GetDescendants()) do
            if esp.Name == "ZeusESP" and esp.Parent then
                local pos = getItemPosition(esp.Parent)
                if pos and LP.Character and LP.Character.PrimaryPart then
                    local dist = (pos - LP.Character.PrimaryPart.Position).Magnitude
                    if dist < closestDist and dist < 30 then
                        closestDist = dist
                        closest = esp.Parent
                    end
                end
            end
        end
        
        if closest then
            local pos = getItemPosition(closest)
            if pos and LP.Character and LP.Character.PrimaryPart then
                if (pos - LP.Character.PrimaryPart.Position).Magnitude > 10 then
                    LP.Character.PrimaryPart.CFrame = CFrame.new(pos + Vector3.new(0, 2, 0))
                end
                wait(0.2)
                -- Имитация нажатия E или клика
                VirtualInput:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                VirtualInput:SendKeyEvent(false, Enum.KeyCode.E, false, game)
            end
        end
        wait(State.settings.stealDelay)
    end
end

-- Автоматическая постановка на базу
local function autoBaseLoop()
    while State.autoBase do
        -- Поиск базы (примерное название)
        local base = nil
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and (string.lower(obj.Name):find("base") or string.lower(obj.Name):find("safe") or string.lower(obj.Name):find("storage")) then
                base = obj
                break
            end
        end
        
        if base and LP.Character and LP.Character.PrimaryPart then
            local pos = base.Position
            if (pos - LP.Character.PrimaryPart.Position).Magnitude > 15 then
                LP.Character.PrimaryPart.CFrame = CFrame.new(pos + Vector3.new(0, 2, 0))
            end
            wait(0.3)
            VirtualInput:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            VirtualInput:SendKeyEvent(false, Enum.KeyCode.E, false, game)
        end
        wait(State.settings.baseDelay)
    end
end

