    label.TextColor3 = Color3.new(1, 1, 1)
    label.TextSize = 12
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame
    
    local slider = Instance.new("TextBox")
    slider.Size = UDim2.new(0.4, 0, 0, 30)
    slider.Position = UDim2.new(0.55, 0, 0.5, -15)
    slider.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
    slider.Text = tostring(getter())
    slider.TextColor3 = Color3.new(1, 1, 1)
    slider.PlaceholderText = "Значение"
    local sliderCorner = Instance.new("UICorner")
    sliderCorner.CornerRadius = UDim.new(0, 6)
    sliderCorner.Parent = slider
    slider.Parent = frame
    
    local minus = Instance.new("TextButton")
    minus.Size = UDim2.new(0, 35, 0, 35)
    minus.Position = UDim2.new(0, 5, 0.5, -17.5)
    minus.BackgroundColor3 = Color3.fromRGB(60, 60, 65)
    minus.Text = "-"
    minus.TextSize = 20
    minus.Font = Enum.Font.GothamBold
    local minusCorner = Instance.new("UICorner")
    minusCorner.CornerRadius = UDim.new(0, 6)
    minusCorner.Parent = minus
    minus.Parent = frame
    
    local plus = minus:Clone()
    plus.Position = UDim2.new(0, 45, 0.5, -17.5)
    plus.Text = "+"
    plus.Parent = frame
    
    local update = function()
        local val = getter()
        label.Text = text .. ": " .. tostring(val)
        slider.Text = tostring(val)
    end
    
    minus.MouseButton1Click:Connect(function()
        local new = math.max(minVal, getter() - 1)
        setter(new)
        update()
    end)
    
    plus.MouseButton1Click:Connect(function()
        local new = math.min(maxVal, getter() + 1)
        setter(new)
        update()
    end)
    
    slider.FocusLost:Connect(function()
        local val = tonumber(slider.Text)
        if val then
            setter(math.clamp(val, minVal, maxVal))
            update()
        end
    end)
    
    return frame
end

